{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/plan", "destination": "/plan/index.html" },
    { "source": "/plan/(.*)", "destination": "/plan/$1" },
    { "source": "/pos", "destination": "/pos/index.html" },
    { "source": "/pos/(.*)", "destination": "/pos/index.html" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/((?!assets|plan|pos|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
}
