{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/pos", "destination": "/index.html" },
    { "source": "/pos/(.*)", "destination": "/index.html" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/((?!assets|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
}
